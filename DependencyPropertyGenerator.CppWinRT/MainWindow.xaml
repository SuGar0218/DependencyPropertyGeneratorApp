<?xml version="1.0" encoding="utf-8" ?>
<Window
	x:Class="DependencyPropertyGenerator.CppWinRT.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:DependencyPropertyGenerator.CppWinRT"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:views="using:DependencyPropertyGenerator.CppWinRT.Views"
	Title="DependencyPropertyGenerator.CppWinRT"
	mc:Ignorable="d">

	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid Loaded="OnRootLoaded">
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<TextBlock
			Grid.Row="0"
			Margin="24,32,24,0"
			DoubleTapped="OnTitleTextBlockDoubleTapped"
			IsDoubleTapEnabled="True"
			Style="{ThemeResource TitleTextBlockStyle}"
			Text="C++/WinRT 依赖属性" />
		<ScrollViewer Grid.Row="1">
			<views:DependencyPropertyInfoView
				x:Name="PART_MainView"
				Margin="24"
				Spacing="8" />
		</ScrollViewer>
	</Grid>

</Window>
